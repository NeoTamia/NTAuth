{
  "name": "@neotamia/ntauth",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "examples/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "db:migrate": "bun --env-file=.env --filter @neotamia/db db:migrate",
    "db:rollback": "bun --env-file=.env --filter @neotamia/db db:rollback",
    "db:seed:ntscout": "bun --env-file=.env --filter @neotamia/db db:seed:ntscout",
    "dev": "bun --env-file=.env turbo run dev --filter='./apps/*' --env-mode=loose",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "load:test": "bun tooling/load-test.ts",
    "release:prepare": "bun tooling/prepare-release-artifacts.ts",
    "release:publish": "bun tooling/publish-release-artifacts.ts",
    "release:verify": "bun tooling/verify-release.ts",
    "test": "bun test tooling && turbo run test --concurrency=1",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "turbo": "2.10.9",
    "typescript": "6.0.3"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "packageManager": "bun@1.3.14"
}
