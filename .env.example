# Runtime shared by API and worker
NODE_ENV=development
DATABASE_URL=postgres://ntauth:ntauth@localhost:5432/ntauth
REDIS_URL=redis://localhost:6379
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# Public canonical URLs
AUTH_BASE_URL=http://localhost:3001/api/auth
NUXT_PUBLIC_API_BASE_URL=http://localhost:3001

# API listener and browser origins (comma-separated absolute origins)
API_HOST=0.0.0.0
API_PORT=3001
API_HOST_PORT=3001
CORS_ORIGINS=http://localhost:3000
WEB_HOST_PORT=3000

# Replace locally; production must inject a randomly generated value of 32+ characters
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-32-characters

# Idempotent NTScout public OAuth client seed
NTSCOUT_ENVIRONMENT=development
NTSCOUT_REDIRECT_URIS=http://127.0.0.1:3003/auth/callback

# SMTP transport used by the worker
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_HOST_PORT=1025
MAILPIT_HTTP_PORT=8025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="NTAuth <no-reply@neotamia.re>"
EMAIL_OUTBOX_POLL_INTERVAL_MS=1000
JOB_LOCK_TIMEOUT_MS=30000
WORKER_HOST=0.0.0.0
WORKER_PORT=3002
WORKER_HOST_PORT=3002
