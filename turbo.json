{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".nuxt/**", ".output/**"] },
    "dev": { "cache": false, "persistent": true },
    "test": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": ["REDIS_URL", "TEST_DATABASE_URL"]
    },
    "typecheck": { "dependsOn": ["^build", "^typecheck"] }
  }
}
