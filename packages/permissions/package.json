{
  "name": "@neotamia/permissions",
  "version": "0.1.0",
  "description": "Framework-independent IAM contracts, validation, and deny-first evaluation for NeoTamia services.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeoTamia/NTAuth.git",
    "directory": "packages/permissions"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target browser --format esm --sourcemap=external && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@neotamia/config": "workspace:*",
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20"
  }
}
