IMAGE_REGISTRY=ghcr.io/neotamia
API_IMAGE_DIGEST=sha256:replace
MIGRATE_IMAGE_DIGEST=sha256:replace
WEB_IMAGE_DIGEST=sha256:replace
WORKER_IMAGE_DIGEST=sha256:replace

AUTH_BASE_URL=https://auth.example.com/api/auth
CORS_ORIGINS=https://auth.example.com
NUXT_PUBLIC_API_BASE_URL=https://auth.example.com
TRUSTED_PROXY_CIDRS=172.16.0.0/12
EDGE_NETWORK=proxy

SMTP_FROM=NTAuth <no-reply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=replace

BETTER_AUTH_SECRET_FILE=./deploy/secrets/better-auth-secret
DATABASE_URL_FILE=./deploy/secrets/database-url
POSTGRES_PASSWORD_FILE=./deploy/secrets/postgres-password
SMTP_PASSWORD_FILE=./deploy/secrets/smtp-password
