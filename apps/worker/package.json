{
  "name": "@neotamia/ntauth-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "enqueue:test": "bun src/enqueue-test.ts",
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neotamia/config": "workspace:*",
    "@neotamia/db": "workspace:*",
    "@neotamia/observability": "workspace:*",
    "nodemailer": "7.0.13"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/nodemailer": "8.0.1",
    "typescript": "6.0.3"
  }
}
